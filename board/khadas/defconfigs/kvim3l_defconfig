# get_rebootmode/reboot/systemoff. Without this ${reboot_mode} is never set,
# and every "if test ${reboot_mode} = ..." in the env degenerates into
# "test = <word>", which hush reports as "syntax error" and then treats as
# true - so switch_bootmode takes the factory_reset branch and boots recovery.
