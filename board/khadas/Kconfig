# function list

# Khadas board targets.
#
# These are plain bools rather than "choice" entries on purpose: this file is
# sourced alongside board/amlogic/Kconfig, which already defines the board
# selection for each SoC. A "choice" here would force one Khadas board to be
# selected even when an Amlogic reference board is being built, and the Khadas
# SYS_BOARD/SYS_CONFIG_NAME defaults would then override the Amlogic ones.

# The KHADAS_* symbols are what the defconfigs select; each pulls in the
# matching TARGET_KHADAS_* that board/khadas/<board>/Kconfig keys off.

if MESON_T7

config KHADAS_VIM4
	bool "Khadas VIM4"
	select TARGET_KHADAS_VIM4

config TARGET_KHADAS_VIM4
	bool "Khadas VIM4 board"

endif


if MESON_S4

config KHADAS_VIM1S
	bool "Khadas VIM1S"
	select TARGET_KHADAS_VIM1S

config TARGET_KHADAS_VIM1S
	bool "Khadas VIM1S board"

endif


if MESON_G12B

config KHADAS_VIM3
	bool "Khadas VIM3"
	select TARGET_KHADAS_VIM3

config TARGET_KHADAS_VIM3
	bool "Khadas VIM3 board"

endif


if MESON_G12A

config KHADAS_VIM3L
	bool "Khadas VIM3L"
	select TARGET_KHADAS_VIM3L

config TARGET_KHADAS_VIM3L
	bool "Khadas VIM3L board"

endif

# Khadas boards

source "board/khadas/kvim4/Kconfig"
source "board/khadas/kvim1s/Kconfig"
source "board/khadas/kvim3/Kconfig"
source "board/khadas/kvim3l/Kconfig"
