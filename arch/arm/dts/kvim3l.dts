/*
 * Khadas VIM3L (S905D3 / SM1)
 *
 * Derived from meson-sm1-s905d3-ac200.dts. This device tree is only used by
 * u-boot's driver model (pinctrl, mmc, i2c, ...); the kernel device tree is
 * loaded at runtime from the "dtb" partition, not from here.
 */

/dts-v1/;

#include "meson-sm1-s905d3-ac200.dtsi"
#include "meson-g12a_skt-panel.dtsi"

/ {
	compatible = "khadas,vim3l", "amlogic,s905d3", "amlogic,meson-sm1";
	model = "Khadas VIM3L";
};

/* Brought out to the 40-pin GPIO header */
&uart_AO {
	status = "okay";
};

&saradc {
	status = "okay";
};

/*
 * i2c3 on GPIOA_14/GPIOA_15, alias i2c3. The vendor kernel leaves this
 * disabled, but u-boot needs it: the touch controller of the TS050/TS101
 * panels (0x38 / 0x5d), the M2X extension board's codec (0x10) and the MIPI
 * camera (0x0c) all live here, and "kbi check_panel"/"check_m2x" read them.
 * The 2015 bootloader bit-banged these two pins by hand for the same purpose.
 */
&i2c3 {
	status = "okay";
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_master_pins2>;
};

/*
 * AO i2c, alias i2c4 (see the aliases node in meson-sm1-s905d3-ac200.dtsi).
 * Carries the KBI MCU at 0x18 and the TCA6408 GPIO expander at 0x20 - see
 * &i2c_AO in the vendor kernel's kvim3l.dts. Without this the "kbi" command
 * and tca6408_gpio_init() fail with -ENODEV.
 */
&i2c_AO {
	status = "okay";
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&ao_i2c_master_pins1>;

	gpio_expander: gpio-controller@20 {
		compatible = "ti,tca6408";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	khadas_mcu: khadas-mcu@18 {
		compatible = "khadas-mcu";
		reg = <0x18>;
	};
};

&pinctrl_periphs {
	bl_pwm_off_pins:bl_pwm_off_pin {
		mux {
			groups = "GPIOH_5";
			function = "gpio_periphs";
			output-high;
		};
	};
}; /* end of pinctrl_periphs */
